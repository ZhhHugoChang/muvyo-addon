{
  "api": 1,
  "id": "zhhhugochang.jying",
  "name": "聚影",
  "version": "1.1.0",
  "min_mv_version": "3.13.0",
  "author": "ZhhHugoChang",
  "description": "支持个人 API Key 或 AppID + 个人 Key 搜索聚影资源，并提供安全限流与每日签到。",
  "release_notes": "新增可选 AppID 接入和聚合搜索；保留仅个人 Key 模式。按官方规则实施独立限流、3 分钟聚合缓存、429 Retry-After 冷却和 AppID 绑定冲突提示。",
  "permissions": {
    "domains": [
      "www.jying.top"
    ]
  },
  "config": [
    {
      "key": "api_key",
      "label": "个人 API Key",
      "type": "secret",
      "required": true,
      "help": "在聚影个人首页验证邮箱后查看或重置。无论是否使用 AppID，都必须填写用户自己的 Key。"
    },
    {
      "key": "app_id",
      "label": "AppID（可选）",
      "type": "secret",
      "required": false,
      "help": "留空时使用个人只读 API；填写有效 AppID 后使用开发接口和聚合搜索。不要填写他人的 AppID。"
    },
    {
      "key": "max_movies",
      "label": "最多匹配影片",
      "type": "number",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "部",
      "default": "5",
      "help": "每次搜索最多读取多少部候选影片的资源。数量越大，请求越多。"
    }
  ],
  "settings": {
    "description": "个人使用只填 API Key；已获批开发应用时再填写 AppID。插件会自动选择接口并遵守对应限流。",
    "links": [
      {
        "title": "获取 API Key",
        "url": "https://www.jying.top/profile?section=integration"
      },
      {
        "title": "API 使用说明",
        "url": "https://www.jying.top/api-developer-guide#personal-access"
      }
    ],
    "sections": [
      {
        "title": "接入",
        "fields": [
          "api_key",
          "app_id",
          "max_movies"
        ]
      }
    ]
  },
  "capabilities": {
    "search": {
      "link_types": [
        "115",
        "123pan",
        "baidupan",
        "guangyapan",
        "aliyundrive",
        "cloud189",
        "magnet",
        "ed2k"
      ],
      "supports_tmdb": true,
      "resolve": false,
      "resolve_cost": "none"
    },
    "tasks": [
      {
        "id": "checkin",
        "title": "每日签到",
        "description": "使用当前配置的个人身份为本人签到；当天已签到时不会重复领取。",
        "kind": "checkin",
        "interval_minutes": 1440,
        "retries": 1
      }
    ],
    "account": {
      "title": "聚影账号"
    }
  }
}
